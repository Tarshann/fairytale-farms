# Live site: https://fairytalefarms.net — set APP_ORIGIN (and/or OAUTH_SERVER_URL) to this in production so checkout redirects work.
APP_ORIGIN=

# Login: set OAUTH_SERVER_URL + VITE_APP_ID for OAuth, or leave both unset to run without login (Option A).
# Production: OAUTH_SERVER_URL=https://fairytalefarms.net
OAUTH_SERVER_URL=

# Core app defaults (optional if dev defaults are acceptable)
DEV_LOGIN_ENABLED=false
JWT_SECRET=
VITE_APP_ID=

# Admin emails — comma-separated list of emails that get admin role on login.
# REQUIRED: without this, no user will be auto-promoted to admin in production.
# Example: ADMIN_EMAILS=owner@example.com,manager@example.com
ADMIN_EMAILS=

# Any other required values your server expects
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# Resend (preferred for Railway — avoids SMTP port blocks)
# Sign up free at resend.com, get an API key, add it here.
# Default sender is onboarding@resend.dev (works without domain verification).
# To use your own domain: verify fairytalefarms.net in Resend and set RESEND_FROM.
RESEND_API_KEY=
RESEND_FROM=Fairytale Farms <noreply@fairytalefarms.net>

# SMTP for login codes (required for email-based login in production)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=your-app-password
# For SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey, SMTP_PASS=your-api-key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Contact form forwarding — all contact form messages are sent to this email.
# Defaults to fairytalefarms.net@gmail.com if not set.
CONTACT_EMAIL=fairytalefarms.net@gmail.com

# SMS notifications (Twilio) — OPTIONAL. Leave blank to disable (SMS becomes a no-op).
# Sign up at twilio.com, buy a number, then set the three values below.
# TWILIO_FROM_NUMBER may be a Twilio number in E.164 (+16155551234) OR a
# Messaging Service SID (MGxxxxxxxx...). ADMIN_SMS_TO is a comma-separated list
# of owner phone numbers that get a text on every new order.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADMIN_SMS_TO=

# Static asset CDN — OPTIONAL. Set to a CDN base URL (e.g. a CloudFront
# distribution in front of the asset origin, https://dxxxx.cloudfront.net) to
# serve product images from the edge. Leave blank to serve from the app origin.
ASSET_CDN_URL=

# Analytics (optional — omit to disable)
# PostHog: sign up at https://us.posthog.com/signup
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Umami: self-host on Railway or sign up at https://cloud.umami.is/signup
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_HOST=
