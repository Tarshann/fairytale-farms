# Live site: https://fairytalefarms.net — set APP_ORIGIN (and/or OAUTH_SERVER_URL) to this in production so checkout redirects work.
APP_ORIGIN=

# Login: set OAUTH_SERVER_URL + VITE_APP_ID for OAuth, or leave both unset to run without login (Option A).
# Production: OAUTH_SERVER_URL=https://fairytalefarms.net
OAUTH_SERVER_URL=

# Core app defaults (optional if dev defaults are acceptable)
DEV_LOGIN_ENABLED=false
JWT_SECRET=
VITE_APP_ID=

# Any other required values your server expects
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# Analytics (optional — omit to disable)
# PostHog: sign up at https://us.posthog.com/signup
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Umami: self-host on Railway or sign up at https://cloud.umami.is/signup
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_HOST=
